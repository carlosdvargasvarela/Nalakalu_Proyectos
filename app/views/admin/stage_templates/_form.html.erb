<%= link_to admin_project_type_path(project_type), class: "d-inline-block mb-3" do %>
  <i class="bi bi-arrow-left"></i> Volver a <%= project_type.name %>
<% end %>

<%= panel_card("#{stage_template.persisted? ? 'Editar' : 'Nuevo'} subproceso — #{project_type.name}") do %>
  <p class="text-muted">
    Los subprocesos son las etapas por las que pasa cada proyecto de este
    tipo (por ejemplo, "Diseño", "Producción", "Entrega"). El orden se
    define arrastrando la lista en <%= link_to project_type.name, admin_project_type_path(project_type) %>.
  </p>

  <%= form_with model: [:admin, project_type, stage_template] do |form| %>
    <% if stage_template.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% stage_template.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :name, class: "form-label" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= form.label :color, class: "form-label" %>
      <%= form.color_field :color, class: "form-control form-control-color" %>
    </div>
    <div class="mb-3 form-check">
      <%= form.check_box :default_in_filter, class: "form-check-input" %>
      <%= form.label :default_in_filter, "Etapa por defecto en el filtro", class: "form-check-label" %>
      <div class="form-text">Se preselecciona al abrir el filtro por etapa en el listado de proyectos.</div>
    </div>
    <%= form.submit class: "btn btn-primary" %>
  <% end %>
<% end %>
