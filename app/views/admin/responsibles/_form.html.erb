<%= panel_card(responsible.persisted? ? "Editar responsable" : "Nuevo responsable") do %>
  <%= form_with model: [:admin, responsible] do |form| %>
    <% if responsible.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% responsible.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :name, class: "form-label" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :color, class: "form-label" %>
      <%= form.color_field :color, class: "form-control form-control-color" %>
    </div>

    <div class="mb-3">
      <%= form.label :user_id, "Usuario vinculado", class: "form-label" %>
      <%= form.collection_select :user_id, unlinked_users, :id, :email, { include_blank: "Ninguno" }, class: "form-select js-tomselect" %>
    </div>

    <div class="mb-3">
      <%= form.label :responsible_project_types, "Tipo de responsable por tipo de proyecto", class: "form-label d-block" %>
      <%= form.fields_for :responsible_project_types, responsible.responsible_project_types.sort_by { |rpt| rpt.project_type.name } do |rpt_form| %>
        <div class="row align-items-center mb-2">
          <div class="col-4"><%= rpt_form.object.project_type.name %></div>
          <div class="col-8">
            <%= rpt_form.hidden_field :project_type_id %>
            <%= rpt_form.select :responsible_type_id,
                  rpt_form.object.project_type.responsible_types.order(:name).pluck(:name, :id),
                  { include_blank: "No habilitado" }, class: "form-select" %>
          </div>
        </div>
      <% end %>
    </div>

    <%= form.submit class: "btn btn-primary" %>
  <% end %>
<% end %>
