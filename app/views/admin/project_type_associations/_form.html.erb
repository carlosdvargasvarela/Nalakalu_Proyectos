<%= link_to admin_project_type_associations_path, class: "d-inline-block mb-3" do %>
  <i class="bi bi-arrow-left"></i> Tipos de asociación
<% end %>

<%= panel_card(project_type_association.persisted? ? "Editar tipo de asociación" : "Nuevo tipo de asociación") do %>
  <p class="text-muted">
    Define que un proyecto del tipo de origen puede vincularse a uno del
    tipo de destino, con la etiqueta elegida (por ejemplo, "Instalación" →
    "Caso de servicio" → "Mantenimiento").
  </p>
  <%= form_with model: [:admin, project_type_association],
        data: {
          controller: "shared-field-mapping",
          shared_field_mapping_fields_by_type_value: @field_definitions_by_type.to_json,
          shared_field_mapping_initial_mappings_value: (project_type_association.shared_field_mappings || []).to_json
        } do |form| %>
    <% if project_type_association.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% project_type_association.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :from_project_type_id, "Tipo de origen", class: "form-label" %>
      <%= form.collection_select :from_project_type_id, ProjectType.order(:name), :id, :name, {},
            class: "form-select", data: { shared_field_mapping_target: "fromType", action: "change->shared-field-mapping#resetRows" } %>
    </div>

    <div class="mb-3">
      <%= form.label :to_project_type_id, "Tipo de destino", class: "form-label" %>
      <%= form.collection_select :to_project_type_id, ProjectType.order(:name), :id, :name, {},
            class: "form-select", data: { shared_field_mapping_target: "toType", action: "change->shared-field-mapping#resetRows" } %>
    </div>

    <div class="mb-3">
      <%= form.label :label, "Etiqueta", class: "form-label" %>
      <%= form.text_field :label, class: "form-control" %>
      <div class="form-text">Cómo se llama esta asociación en el detalle del proyecto (ej. "Mantenimiento").</div>
    </div>

    <div class="form-check mb-3">
      <%= form.check_box :responsables_can_create, class: "form-check-input" %>
      <%= form.label :responsables_can_create, "Responsables pueden crear", class: "form-check-label" %>
      <div class="form-text">Sin esto, solo Admin y Gerente pueden crear el proyecto de destino desde acá; con esto, un usuario con rol Responsable también puede.</div>
    </div>

    <div class="mb-3">
      <%= form.label :shared_field_mappings, "Campos compartidos", class: "form-label" %>
      <p class="form-text">Elegí qué campo del tipo de origen precarga cuál campo del tipo de destino al crear un proyecto asociado. Solo se pueden mapear campos del mismo tipo de dato.</p>
      <div data-shared-field-mapping-target="rows"></div>
      <button type="button" class="btn btn-outline-secondary btn-sm mt-2" data-action="click->shared-field-mapping#addBlankRow">+ Agregar campo compartido</button>
    </div>

    <%= form.submit class: "btn btn-primary" %>
  <% end %>
<% end %>
