<%# app/views/projects/_edit_log_entry_modals.html.erb %>
<% entries.each do |entry| %>
  <% next unless entry.user == current_user || current_user.admin? || current_user.gerente? %>
  <div class="modal fade" id="edit-log-entry-modal-<%= entry.id %>" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <%= form_with model: entry, url: project_log_entry_path(project, entry), method: :patch do |form| %>
          <div class="modal-header">
            <h5 class="modal-title">Editar nota</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <%= form.rich_text_area :body, id: "bitacora-trix-editor-edit-#{entry.id}", class: "trix-content mb-2", data: { controller: "trix-attachments" } %>
            <%= form.collection_select :log_entry_type_id, project.project_type.log_entry_types, :id, :name, {}, class: "form-select form-select-sm w-auto" %>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <%= form.submit "Guardar", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
