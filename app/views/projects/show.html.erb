<%= link_to project_type_projects_path(@project.project_type.slug), class: "d-inline-block mb-2" do %>
  <i class="bi bi-arrow-left"></i> <%= @project.project_type.name %>
<% end %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="d-inline-block me-2 mb-0"><%= @project.name %></h1>
    <%= status_badge(@project.status) %>
    <%= progress_status_badge(@project.progress_status) if current_user.show_project_progress? %>
    <%= overdue_badge if @project.overdue? %>
    <p class="text-muted mb-0">Tipo: <%= @project.project_type.name %></p>
  </div>
  <% if current_user.can_edit_project?(@project) %>
    <div class="d-flex gap-2">
      <%= link_to edit_project_path(@project), class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-pencil"></i> Editar
      <% end %>
      <%= render "archive_button", project: @project %>
    </div>
  <% end %>
</div>

<%= render "data_band", project: @project, fields: @project.project_type.field_definitions %>

<% content_for :head do %>
  <link href="https://cdn.jsdelivr.net/npm/frappe-gantt@1.2.2/dist/frappe-gantt.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/trix@2.1.6/dist/trix.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/trix@2.1.6/dist/trix.umd.min.js"></script>
<% end %>

<%
  # ponytail: a stage with no dates gets a one-week placeholder window starting at
  # the project's creation date, so the chart always has something to draw. This is
  # a visual approximation, not real data — real dates come from editing the stage.
  # Project types with require_stage_dates skip that placeholder entirely instead:
  # an undated stage just doesn't appear on this Gantt until it has real dates.
  stages = @project.project_stages.applicable.includes(:stage_template).order(:id)
  require_dates = @project.project_type.require_stage_dates? || @project.project_type.auto_stage_duration_enabled?
  visible_stages = require_dates ? stages.reject(&:dates_missing?) : stages
  gantt_tasks = visible_stages.map do |stage|
    stage_start = stage.start_date || @project.created_at.to_date
    stage_end = stage.end_date || (stage_start + 7.days)
    {
      id: stage.id.to_s,
      name: stage.name,
      start: stage_start.to_s,
      end: stage_end.to_s,
      progress: stage.progress_percent,
      custom_class: "stage-color-#{stage.stage_template_id || "custom-#{stage.id}"}"
    }
  end
  # Template-backed stages share one legend entry per template (as before); a
  # project-specific stage (no stage_template) gets its own entry with its own
  # name and color instead of collapsing into a single generic "Sin subproceso" bucket.
  stage_colors = stages.map do |stage|
    if stage.stage_template_id
      [stage.stage_template_id, stage.stage_template.name, stage.stage_template.color]
    else
      ["custom-#{stage.id}", stage.name, stage.color]
    end
  end.uniq

  @project_events = @project.events.includes(:event_type, :project_stage, :responsible).order(:event_date)
  stage_less_events = @project_events.select(&:project_wide?)

  # A single synthetic "Eventos del proyecto" row hosts every stage-less event as an
  # overlaid marker (see drawEventMarkers in gantt_stage_editor_controller.js) - frappe-gantt
  # 1.2.2 silently ignores `type: "milestone"` and renders an ordinary draggable bar instead,
  # so a real milestone type isn't available here.
  if stage_less_events.any?
    event_dates = stage_less_events.map(&:event_date)
    gantt_tasks << {
      id: "project-events",
      name: "Eventos del proyecto",
      start: event_dates.min.to_s,
      end: (event_dates.max + 1.day).to_s,
      progress: 0,
      custom_class: "project-events-row"
    }
  end
  # Stages are stored/queried in creation order (roughly template position),
  # not chronological order - a project with custom stages added out of date
  # order would otherwise render (and "Invertir orden" would toggle) a
  # meaningless order instead of an actual ascending/descending date sort.
  gantt_tasks = gantt_tasks.sort_by { |task| task[:start] }

  events_data = @project_events.map do |event|
    {
      id: event.id,
      project_stage_id: (event.project_wide? ? "project-events" : event.project_stage_id).to_s,
      event_date: event.event_date.to_s,
      title: event.title,
      color: event.event_type.color
    }
  end
  event_type_legend = @project_events.map { |event| [event.event_type.name, event.event_type.color] }.uniq
%>
<div class="card mb-4">
  <div class="card-header">Cronograma</div>
  <div class="card-body" data-controller="gantt-stage-editor"
       data-gantt-stage-editor-patch-url-value="<%= project_path(@project) %>"
       data-gantt-stage-editor-tasks-value="<%= gantt_tasks.to_json %>"
       data-gantt-stage-editor-colors-value="<%= stage_colors.to_json %>"
       data-gantt-stage-editor-events-value="<%= events_data.to_json %>">
    <div class="btn-group btn-group-sm mb-2" role="group" id="view-mode-show">
      <button type="button" class="btn btn-outline-secondary view-mode-btn active" data-mode="Day"
              data-gantt-stage-editor-target="viewModeButton" data-action="click->gantt-stage-editor#changeViewMode">Día</button>
      <button type="button" class="btn btn-outline-secondary view-mode-btn" data-mode="Week"
              data-gantt-stage-editor-target="viewModeButton" data-action="click->gantt-stage-editor#changeViewMode">Semana</button>
      <button type="button" class="btn btn-outline-secondary view-mode-btn" data-mode="Month"
              data-gantt-stage-editor-target="viewModeButton" data-action="click->gantt-stage-editor#changeViewMode">Mes</button>
      <button type="button" class="btn btn-outline-secondary" data-gantt-stage-editor-target="sortButton"
              data-action="click->gantt-stage-editor#toggleSort" title="Invertir orden">
        <i class="bi bi-sort-down"></i>
      </button>
    </div>
    <%= render "gantt_legend", entries: stage_colors.map { |_, name, color| [name, color] } + event_type_legend %>
    <div id="gantt" data-gantt-stage-editor-target="chart" class="mb-4"></div>

    <script src="https://cdn.jsdelivr.net/npm/frappe-gantt@1.2.2/dist/frappe-gantt.umd.js"></script>

    <% if current_user.can_edit_project?(@project) %>
      <%= render "stage_table", project: @project %>
    <% elsif current_user.editable_project_stage_ids(@project).any? %>
      <%= render "stage_table_restricted", project: @project, editable_stage_ids: current_user.editable_project_stage_ids(@project) %>
    <% end %>
  </div>
</div>

<%
  project_responsibles_for_events = @project.project_type.responsibles.order(:name)
%>
<%= render "events_table", project: @project, events: @project_events %>
<%= render "add_event_modal", project: @project, responsibles: project_responsibles_for_events if current_user.can_edit_project?(@project) %>
<%= render "edit_event_modals", project: @project, events: @project_events, responsibles: project_responsibles_for_events if current_user.can_edit_project?(@project) %>

<% if current_user.can_edit_project?(@project) %>
  <%
    responsibles_by_type = @project.project_type.responsible_project_types.includes(:responsible)
      .group_by { |rpt| rpt.responsible_type_id.to_s }
      .transform_values { |rows| rows.map { |rpt| [rpt.responsible_id, rpt.responsible.name] }.sort_by { |_, name| name } }
    grouped_responsibles = @project.project_responsibles.includes(:responsible, :responsible_type, :project_stage)
      .group_by(&:project_stage_id)
    stage_groups = [[nil, "Todo el proyecto"]] + @project.project_stages.map { |s| [s.id, s.name] }
    taken_by_type_and_stage = @project.project_responsibles.pluck(:responsible_type_id, :project_stage_id, :responsible_id)
      .each_with_object(Hash.new { |h, k| h[k] = [] }) { |(type_id, stage_id, resp_id), h| h["#{type_id}_#{stage_id}"] << resp_id }
    responsibles_by_type_and_stage = responsibles_by_type.each_with_object({}) do |(type_id, options), memo|
      stage_groups.each do |stage_id, _|
        memo["#{type_id}_#{stage_id}"] = options.reject { |resp_id, _| taken_by_type_and_stage["#{type_id}_#{stage_id}"].include?(resp_id) }
      end
    end
  %>
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      Responsables
      <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#add-responsible-modal">
        <i class="bi bi-plus-lg"></i> Agregar
      </button>
    </div>
    <div class="card-body">
      <% if grouped_responsibles.empty? %>
        <p class="text-muted mb-0">Todavía no hay responsables asignados.</p>
      <% end %>
      <% stage_groups.each do |stage_id, stage_name| %>
        <% prs = grouped_responsibles[stage_id] || [] %>
        <% next if prs.empty? %>
        <h6 class="text-muted mt-2"><%= stage_name %></h6>
        <ul class="list-group list-group-flush mb-3">
          <% prs.each do |pr| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span>
                <span class="badge me-2" style="background-color: <%= pr.responsible_color %>">&nbsp;</span>
                <%= pr.responsible_name %><%= " (eliminado)" if pr.responsible_id.nil? %> — <%= pr.responsible_type.name %>
              </span>
              <%= button_to "Quitar", project_project_responsible_path(@project, pr), method: :delete,
                    class: "btn btn-outline-danger btn-sm", form: { style: "display:inline-block", onsubmit: "return confirm('¿Quitar responsable?')" } %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>

  <div class="modal fade" id="add-responsible-modal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_with model: ProjectResponsible.new, url: project_project_responsibles_path(@project),
              data: { controller: "dependent-select", dependent_select_options_value: responsibles_by_type_and_stage.to_json } do |form| %>
          <div class="modal-header">
            <h5 class="modal-title">Agregar responsable</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <%= form.label :responsible_type_id, "1. Tipo", class: "form-label" %>
              <%= form.collection_select :responsible_type_id, @project.project_type.responsible_types.order(:name), :id, :name,
                    { include_blank: "Elegí un tipo" }, class: "form-select",
                    data: { dependent_select_target: "control", action: "change->dependent-select#apply" } %>
            </div>
            <div class="mb-3">
              <%= form.label :project_stage_id, "2. Etapa", class: "form-label" %>
              <%= form.collection_select :project_stage_id, @project.project_stages, :id, :name, { include_blank: "Todo el proyecto" }, class: "form-select",
                    data: { dependent_select_target: "control", action: "change->dependent-select#apply" } %>
            </div>
            <div class="mb-0">
              <%= form.label :responsible_id, "3. Responsable", class: "form-label" %>
              <%= form.select :responsible_id, [], { include_blank: "Elegí un tipo primero" }, class: "form-select",
                    data: { dependent_select_target: "select" } %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <%= form.submit "Agregar", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% if current_user.can_edit_project?(@project) || ProjectTypeAssociation.where(to_project_type: @project.project_type, responsables_can_create: true).any? { |a| current_user.can_create_associated_project?(a, @project) } %>
  <div class="card mb-4">
    <div class="card-header">Asociaciones</div>
    <div class="card-body">
      <ul class="list-group list-group-flush mb-3">
        <% @project.outgoing_project_associations.includes(:to_project, :project_type_association).each do |pa| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Este proyecto es <strong><%= pa.project_type_association.label %></strong> de <%= link_to pa.to_project.name, project_path(pa.to_project) %></span>
            <% if current_user.can_edit_project?(@project) %>
              <%= button_to "Quitar", project_project_association_path(@project, pa), method: :delete, class: "btn btn-outline-danger btn-sm" %>
            <% end %>
          </li>
        <% end %>
        <% @project.incoming_project_associations.includes(:from_project, :project_type_association).each do |pa| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><%= link_to pa.from_project.name, project_path(pa.from_project) %> es <strong><%= pa.project_type_association.label %></strong> de este proyecto</span>
            <% if current_user.can_edit_project?(@project) %>
              <%= button_to "Quitar", project_project_association_path(@project, pa), method: :delete, class: "btn btn-outline-danger btn-sm" %>
            <% end %>
          </li>
        <% end %>
      </ul>

      <% if current_user.can_edit_project?(@project) %>
        <%
          applicable_associations = ProjectTypeAssociation.where(from_project_type: @project.project_type).or(ProjectTypeAssociation.where(to_project_type: @project.project_type))
          association_options = applicable_associations.map do |a|
            other_type_id = a.from_project_type_id == @project.project_type_id ? a.to_project_type_id : a.from_project_type_id
            [a.label, a.id, { data: { key: other_type_id } }]
          end
          relevant_type_ids = association_options.map { |_, _, opts| opts[:data][:key] }.uniq
          projects_by_other_type = Project.where.not(id: @project.id).where(project_type_id: relevant_type_ids).order(:name).group_by(&:project_type_id)
            .transform_values { |projects| projects.map { |p| [p.id, p.name] } }
        %>
        <%= form_with url: project_project_associations_path(@project), method: :post, scope: :project_association, class: "row g-2 mb-3",
              data: { controller: "dependent-select", dependent_select_options_value: projects_by_other_type.to_json } do |f| %>
          <div class="col-auto">
            <%= f.select :project_type_association_id, options_for_select(association_options),
                  { include_blank: "Tipo de asociación" }, class: "form-select", id: "project_association_project_type_association_id",
                  data: { dependent_select_target: "control", action: "change->dependent-select#apply" } %>
          </div>
          <div class="col-auto">
            <%= f.select :other_project_id, [], { include_blank: "Proyecto" }, class: "form-select", id: "project_association_other_project_id",
                  data: { dependent_select_target: "select" } %>
          </div>
          <div class="col-auto">
            <%= f.submit "Vincular", class: "btn btn-primary" %>
          </div>
        <% end %>
      <% end %>

      <% ProjectTypeAssociation.where(to_project_type: @project.project_type).each do |association| %>
        <% if current_user.can_create_associated_project?(association, @project) %>
          <%= link_to "+ Nuevo #{association.label}",
                new_project_path(project_type_id: association.from_project_type_id, project_type_association_id: association.id, associate_with_project_id: @project.id),
                class: "btn btn-outline-primary btn-sm" %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-header">Bitácora</div>
  <div class="card-body">
    <% if current_user.can_edit_project?(@project) || (current_user.visor? && current_user.can_view_project?(@project)) %>
      <%= form_with model: LogEntry.new, url: project_log_entries_path(@project), class: "mb-3" do |f| %>
        <%= f.rich_text_area :body, id: "bitacora-trix-editor", class: "trix-content mb-2", data: { controller: "trix-attachments" } %>
        <div class="d-flex gap-2">
          <%= f.collection_select :log_entry_type_id, @project.project_type.log_entry_types, :id, :name, {}, class: "form-select form-select-sm w-auto" %>
          <%= f.submit "Agregar", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    <% end %>
    <ul class="list-group list-group-flush">
      <%
        editable_log_entries = @project.log_entries.includes(:user, :log_entry_type).order(created_at: :desc)
      %>
      <% editable_log_entries.each do |entry| %>
        <% can_edit_entry = entry.user == current_user || current_user.admin? || current_user.gerente? %>
        <li class="list-group-item d-flex justify-content-between align-items-start">
          <div>
            <span class="badge" style="background-color: <%= entry.log_entry_type.color %>"><%= entry.log_entry_type.name %></span>
            <%= entry.body %>
            <div class="text-muted small"><%= entry.user.email %> — <%= l(entry.created_at, format: :short) %></div>
          </div>
          <div class="d-flex gap-2">
            <% if can_edit_entry %>
              <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#edit-log-entry-modal-<%= entry.id %>">
                Editar
              </button>
            <% end %>
            <% if entry.user == current_user %>
              <%= button_to "Eliminar", project_log_entry_path(@project, entry), method: :delete, class: "btn btn-sm btn-outline-danger" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<%= render "edit_log_entry_modals", project: @project, entries: editable_log_entries %>

<div class="card mb-4">
  <div class="card-header">Historial de cambios</div>
  <div class="card-body">
    <ul class="list-group list-group-flush">
      <% @project_change_versions.each do |version| %>
        <li class="list-group-item small">
          <strong>
            <% if version.item_type == "ProjectStage" && version.item.present? %>(Etapa: <%= version.item.name %>) <% end %>
            <%= version.event == "create" ? "Creado" : (version.changeset.keys - ["updated_at"]).map { |field| version.item_type.constantize.human_attribute_name(field) }.join(", ") %>
          </strong>
          por <%= version.whodunnit ? @version_authors[version.whodunnit]&.email : "sistema" %>
          — <%= l(version.created_at, format: :short) %>
          <% unless version.event == "create" %>
            <% version.changeset.except("updated_at").each do |field, change| %>
              <div class="text-muted">· <%= version.item_type.constantize.human_attribute_name(field) %>: <%= format_change_value(change[0]) %> → <%= format_change_value(change[1]) %></div>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
