<%= form_with model: project do |form| %>
  <% if project.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :project_type_id, value: project_type.id %>
  <%= hidden_field_tag :project_type_association_id, @project_type_association_id if @project_type_association_id.present? %>
  <%= hidden_field_tag :associate_with_project_id, @associate_with_project_id if @associate_with_project_id.present? %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <% if !project.persisted? && project_type.auto_stage_duration_enabled? %>
    <div class="mb-3">
      <%= label_tag :auto_duration_start_date, "Fecha de inicio", class: "form-label" %>
      <%= date_field_tag :auto_duration_start_date, nil, class: "form-control", required: true %>
      <div class="form-text">Este tipo de proyecto calcula automáticamente la duración de cada etapa a partir de esta fecha.</div>
    </div>
  <% end %>

  <% project_type.field_definitions.each do |field| %>
    <%= render "field_input", form: form, field: field, project: project %>
  <% end %>

  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancelar", project.persisted? ? project_path(project) : projects_path, class: "btn btn-outline-secondary" %>
<% end %>
