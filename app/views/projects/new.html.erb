<%= link_to @project_type ? project_type_projects_path(@project_type.slug) : projects_path, class: "d-inline-block mb-3" do %>
  <i class="bi bi-arrow-left"></i> <%= @project_type ? @project_type.name : "Proyectos" %>
<% end %>

<%= panel_card("Nuevo proyecto — #{@project_type.name}") do %>
  <%= render "form", project: @project, project_type: @project_type %>
<% end %>
